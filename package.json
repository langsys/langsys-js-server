{
    "name": "langsys-js-server",
    "version": "0.1.0",
    "description": "Request-scoped server-side translation for Langsys \u2014 renders translated, crawler-visible HTML during SSR on Node, Deno, Bun and Workers.",
    "author": "Langsys",
    "license": "MIT",
    "homepage": "https://github.com/langsys/langsys-js-server",
    "repository": {
        "type": "git",
        "url": "git+ssh://git@github.com/langsys/langsys-js-server.git"
    },
    "bugs": {
        "url": "https://github.com/langsys/langsys-js-server/issues"
    },
    "engines": {
        "node": ">=18"
    },
    "sideEffects": false,
    "main": "dist/index.js",
    "module": "dist/index.mjs",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "README.md",
        "CHANGELOG.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "prepublishOnly": "npm run build",
        "test:runtimes": "./_dev_/runtime-conformance.sh",
        "test:all": "npm run build && npm run test && npm run test:runtimes && npm run test:e2e && npm run test:tarball",
        "example:install": "cd example && npm install",
        "example:build": "cd example && npm run build",
        "test:e2e": "npm run build && npm run example:build && vitest run --config vitest.e2e.config.ts",
        "test:tarball": "./_dev_/tarball-acceptance.sh",
        "release": "./_dev_/publish.sh"
    },
    "keywords": [
        "i18n",
        "l10n",
        "ssr",
        "server-side-rendering",
        "localization",
        "internationalization",
        "translation",
        "langsys",
        "sdk",
        "typescript"
    ],
    "devDependencies": {
        "@types/node": "^22.10.0",
        "happy-dom": "^20.11.6",
        "langsys-js-typescript": "^0.6.5",
        "miniflare": "^4.20260730.0",
        "tsup": "^8.4.0",
        "typescript": "^5.8.3",
        "vitest": "^4.1.7"
    },
    "dependencies": {
        "intl-messageformat": "^11.2.7",
        "parse5": "^7.2.1"
    }
}
